# Kopiera till .env och fyll i. Lägg ALDRIG upp .env på GitHub.

# Port som servern lyssnar på
PORT=3000

# E-post (SMTP). Utan SMTP_HOST skrivs verifieringskoderna ut i terminalen.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Chatt <no-reply@example.com>"

# TURN-server för samtal genom strikta nätverk (t.ex. mobilnät). Valfritt.
TURN_URL=
TURN_USER=
TURN_PASS=
